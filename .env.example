# PayChangu Inline Checkout (https://developer.paychangu.com/docs/inline-popup)
# Public key is used client-side to open the PayChangu inline popup.
NEXT_PUBLIC_PAYCHANGU_PUBLIC_KEY=pub-test-your_public_key

# Secret key is used server-side to verify transactions and process webhooks.
PAYCHANGU_SECRET_KEY=your_paychangu_secret_key

# Optional but recommended for webhook signature verification (SHA-256 HMAC).
PAYCHANGU_WEBHOOK_SECRET=your_paychangu_webhook_secret

# Public base URL of this app, used to build callback/return URLs for PayChangu.
# Example: https://your-domain.com
NEXT_PUBLIC_APP_URL=http://localhost:3000